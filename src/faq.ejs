<!-- Hero -->
<section class="hero text-center">
  <div class="container">
    <h1>FAQ</h1>
    <img src="img/faq.jpg" class="img-fluid" alt="">
  </div>
</section>



<div class="container">
  <div class="row">
    <div class="col-lg-12 col-xl-12">
      <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="card-body p-5 p-lg-6">


          <div class="accordion" id="accordionFAQ">          
          <% 
            var i=0; 
            var faq=[ 
            {
              "q" : "В какой стране это работает?", 
              "a" : "Это концепт, адаптированный под <strong>Германию</strong>. Все инструменты, банки и партнерки, о которых я рассказываю, работают именно на немецком рынке."
            }, 
            {
              "q": "Нужны ли вложения для старта?", 
              "a": "<strong>Нет</strong>, суть челленджа — начать с абсолютного нуля. Я буду использовать бесплатные методы привлечения трафика и инструменты, которые не стоят ни копейки."
            },                     
            {
              "q":"Нужно ли знать немецкий язык?",
              "a":"Для старта достаточно базового понимания. Я покажу, как использовать нейросети и переводчики, чтобы создавать контент и работать с немецкими партнерками."
            },
            {
              "q":"Это вообще легально в Германии?",
              "a":"<strong>Да</strong>, это классический бизнес. Как только пойдут первые регулярные доходы, нужно будет открыть Gewerbe. Я  расскажу об этом этапе подробнее, когда мы к нему придем."
            },
            {
              "q":"Сколько времени в день на это нужно тратить?",
              "a":"Если у тебя есть 1–4 часа свободного времени после работы или учебы, этого достаточно, чтобы начать видеть прогресс. Главное — регулярность."
            },
                      {
              "q":"Что делать, если у меня нет опыта в продажах?",
              "a":"Тебе и не нужно быть продавцом. Наша задача — просто рекомендовать полезные сервисы, которыми люди и так пользуются (например, выгодные банковские счета)."
            },
                      {
              "q":"Реально ли заработать миллион за год?",
              "a":"Это амбициозная цель. Но даже если мы достигнем 10% от нее, это будет 100.000 евро. Я здесь, чтобы показать сам путь и механику роста."
            },
            {
              "q":"На чем именно мы будем зарабатывать?",
              "a":"Мы начнем с простых финансовых продуктов (бесплатные карты, счета), а затем перейдем к более дорогим нишам: страхование и газ, электричество, путешествия, парфюмерия, софт для бизнеса и т.д.. Поскольку мы поэтапно разрабатываем множество различных продуктов, вероятность достижения поставленной цели возрастает."
            },
            {
              "q":"Почему ты рассказываешь об этом бесплатно?",
              "a":"Это социальный эксперимент, и чем больше людей мы охватим, тем лучше будет эксперимент. В случае платного курса целевая группа меньше; здесь же любой, у кого есть мобильный телефон, время и мотивация, может принять непосредственное участие."
            },
            {
              "q":"Как мне начать прямо сейчас?",
              "a":"Подпишись, сохрани первое видео со списком инструментов и просто повторяй мои действия из сегодняшнего выпуска.<p><strong>Если ты хочешь дойти до миллиона — Мы идем с нуля вместе.</strong></p>"
            }
            ];                    
            faq.forEach(function(item) { 
            i++; 
            %>            
              <div class="accordion-item">
                <h2 class="accordion-header" id="h<%=i%>">
                  <button class="accordion-button <%= i!=1?"collapsed":"" %>" type="button" data-bs-toggle="collapse" data-bs-target="#c<%=i%>"
                    aria-expanded="<%= i==1?"true":"false" %>" aria-controls="c<%=i%>">
                      <%=i%> . <%- item.q %>
                  </button>
                </h2>
                <div id="c<%=i%>" class="accordion-collapse collapse <%= i==1?"show":"" %>" aria-labelledby="h<%=i%>"
                  data-bs-parent="#accordionFAQ">
                  <div class="accordion-body">
                    <%- item.a %>
                  </div>
                </div>
              </div>
              <% }); %>
              </div>


          </div>
        </div>
      </div>
    </div>
  </div>