<!-- Hero -->
<section class="hero text-center">
  <div class="container">
    <h1>FAQ</h1>
    <img src="img/faq.jpg" class="img-fluid" alt="">
  </div>
</section>



<div class="container">
  <div class="row">
    <div class="col-lg-12 col-xl-12">
      <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="card-body p-5 p-lg-6">


          <div class="accordion" id="accordionFAQ">          
          <% 
            var i = 0;    
            //var faq from _harp.json file
            faq.forEach(function(item) { 
            i++; 
            %>            
              <div class="accordion-item">
                <h2 class="accordion-header" id="h<%=i%>">
                  <button class="accordion-button <%= i!=1?"collapsed":"" %>" type="button" data-bs-toggle="collapse" data-bs-target="#c<%=i%>"
                    aria-expanded="<%= i==1?"true":"false" %>" aria-controls="c<%=i%>">
                      <%=i%> . <%- item.q %>
                  </button>
                </h2>
                <div id="c<%=i%>" class="accordion-collapse collapse <%= i==1?"show":"" %>" aria-labelledby="h<%=i%>"
                  data-bs-parent="#accordionFAQ">
                  <div class="accordion-body">
                    <%- item.a %>
                  </div>
                </div>
              </div>
              <% }); %>
              </div>


          </div>
        </div>
      </div>
    </div>
  </div>